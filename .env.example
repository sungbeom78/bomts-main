# bomts-main serves a static public website and requires no runtime secret.
#
# Keep this file limited to placeholders. Store live values in the private
# bomts-infra repository's secret delivery system or on the target host.

# Public, non-secret identifiers
BOMTS_PUBLIC_SITE_URL=https://www.bomts.net
BOMTS_DECISION_PUBLIC_URL=https://decision.bomts.net

# Server-specific values: examples only; never commit live values here.
BOMTS_PUBLIC_IPV4=REPLACE_ME
BOMTS_HOST_NETWORK_IP=REPLACE_ME
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_ME
CLOUDFLARE_API_TOKEN=REPLACE_ME
MAIL_ADMIN_PASSWORD=REPLACE_ME
SMTP_RELAY_PASSWORD=REPLACE_ME
DATABASE_URL=REPLACE_ME
